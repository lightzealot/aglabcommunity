# Base de datos (en EasyPanel: URL interna del servicio Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/aglab

# Better Auth
BETTER_AUTH_SECRET=genera-uno-con-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3100

# Admins (emails separados por coma): se aprueban solos y quedan como admin al registrarse
ADMIN_EMAIL=hello@andresgomez.store

# SMTP (Namecheap Private Email)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=hello@andresgomez.store
SMTP_PASS=
SMTP_FROM="AG Lab <hello@andresgomez.store>"

# Google OAuth (opcional). Con ambas llenas, aparece el botón de Google (se lee en runtime)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Carpeta de imágenes subidas (en producción, monta un volumen aquí)
UPLOAD_DIR=./uploads

# Zona horaria para la racha diaria y el resumen semanal (lunes 8:00)
APP_TIMEZONE=America/Bogota
# Activa los trabajos programados (recordatorios y resumen). El Dockerfile ya lo activa.
ENABLE_JOBS=false
